[Unit]
Description=Hobby Server Monitor Background Collector
After=network.target lxd.service

[Service]
User=root
WorkingDirectory=/opt/hobby-monitor/backend
ExecStart=/opt/hobby-monitor/backend/venv/bin/python collector.py
Restart=always
Environment="PATH=/opt/hobby-monitor/backend/venv/bin"

[Install]
WantedBy=multi-user.target
