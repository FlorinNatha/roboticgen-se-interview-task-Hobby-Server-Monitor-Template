---
import '../styles/global.css';
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Hobby Server Monitor | Dashboard</title>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="dashboard-body">
	<nav class="navbar">
		<div class="nav-brand">🖥️ Server Monitor</div>
		<div class="nav-user">
			<span id="userEmail">Loading...</span>
			<button id="logoutBtn" class="btn btn-outline">Logout</button>
		</div>
	</nav>

	<main class="dashboard-container">
		<div class="sidebar">
			<h3>Create Container</h3>
			<form id="createForm" class="create-form">
				<div class="form-group">
					<label for="cName">Container Name</label>
					<input type="text" id="cName" required placeholder="e.g. web-server" />
				</div>
				
				<div class="form-group">
					<label for="cRam">RAM Limit (MB): <span id="ramVal">512</span></label>
					<input type="range" id="cRam" min="256" max="4096" step="256" value="512" />
				</div>

				<div class="form-group">
					<label for="cCpu">CPU Cores: <span id="cpuVal">1</span></label>
					<input type="range" id="cCpu" min="1" max="4" step="1" value="1" />
				</div>

				<button type="submit" class="btn btn-primary" id="createBtn">Launch Container</button>
			</form>

			<!-- Invite User Form (Admin Only) -->
			<div id="inviteSection" style="display:none; margin-top: 32px;">
				<hr style="border-color: var(--border-color); margin-bottom: 24px;" />
				<h3>Invite User</h3>
				<form id="inviteForm" class="create-form">
					<div class="form-group">
						<label for="uEmail">User Email</label>
						<input type="text" id="uEmail" required placeholder="user@example.com" />
					</div>
					<button type="submit" class="btn btn-primary">Send Invite</button>
				</form>
			</div>
		</div>

		<div class="main-content">
			<div class="header-row">
				<h2>Your Containers</h2>
				<button id="refreshBtn" class="btn btn-outline">🔄 Refresh</button>
			</div>
			
			<div id="containerGrid" class="container-grid">
				<p>Loading containers...</p>
			</div>

			<div id="adminUsersSection" style="display:none; margin-top: 40px;">
				<div class="header-row">
					<h2>User Management & Quotas</h2>
					<button id="refreshUsersBtn" class="btn btn-outline">🔄 Refresh</button>
				</div>
				<div id="usersGrid" class="container-grid"></div>
			</div>
		</div>
	</main>

	<!-- Terminal Modal -->
	<div id="terminalModal" class="modal" style="display: none;">
		<div class="modal-content terminal-content">
			<div class="modal-header">
				<h3 id="termTitle">Terminal</h3>
				<span class="close" onclick="document.getElementById('terminalModal').style.display='none'">&times;</span>
			</div>
			<div id="termOutput" class="terminal-output"></div>
			<form id="termForm" style="display:flex; gap: 8px; margin-top: 10px;">
				<input type="text" id="termInput" placeholder="Enter command (e.g. ls -la)..." autocomplete="off" style="flex:1; padding:8px; background:#000; color:#fff; border:1px solid #30363d; border-radius:4px;" />
				<button type="submit" class="btn btn-primary" style="width: auto;">Run</button>
			</form>
		</div>
	</div>

	<script>
		const API_URL = "http://localhost:8000/api";
		
		// Update sliders
		document.getElementById('cRam').addEventListener('input', (e) => {
			document.getElementById('ramVal').textContent = e.target.value;
		});
		document.getElementById('cCpu').addEventListener('input', (e) => {
			document.getElementById('cpuVal').textContent = e.target.value;
		});

		// State
		let currentUserRole = 'user';

		// Fetch User Info to handle Roles
		async function fetchUser() {
			try {
				const res = await fetch(`${API_URL}/me`, {credentials: 'include'});
				if(!res.ok) throw new Error('Unauth');
				const user = await res.json();
				currentUserRole = user.role;
				
				let displayStr = `${user.email} (${user.role})`;
				if(user.role === 'user') displayStr += ` | Quota: ${user.quota_ram}MB, ${user.quota_cpu}C`;
				document.getElementById('userEmail').textContent = displayStr;
				
				if(user.role === 'admin') {
					document.getElementById('inviteSection').style.display = 'block';
					document.getElementById('adminUsersSection').style.display = 'block';
					fetchUsers();
				} else {
					const createForm = document.getElementById('createForm');
					createForm.style.display = 'none';
					createForm.parentElement.innerHTML += '<p style="color:#8b949e">You are a standard user. You can view and manage containers assigned to you.</p>';
				}
			} catch(e) {
				window.location.href = "/";
			}
		}

		// Fetch Containers
		async function fetchContainers() {
			const grid = document.getElementById('containerGrid');
			grid.innerHTML = '<p>Loading...</p>';
			
			try {
				const res = await fetch(`${API_URL}/containers`, {credentials: 'include'});
				if (!res.ok) throw new Error('Unauthorized');
				
				const containers = await res.json();
				grid.innerHTML = '';
				
				if(containers.length === 0) {
					grid.innerHTML = '<p class="empty-state">No containers found.</p>';
					return;
				}

				for (const c of containers) {
					const card = document.createElement('div');
					card.className = 'container-card';
					
					const statusClass = c.state === 'Running' ? 'status-running' : 'status-stopped';
					
					let metricsHtml = '<p style="margin-top:8px; font-size:0.85rem; color:#8b949e;">Metrics: Stopped</p>';
					if (c.state === 'Running') {
						try {
							const mRes = await fetch(`${API_URL}/containers/${c.name}/metrics`, {credentials: 'include'});
							if(mRes.ok) {
								const m = await mRes.json();
								metricsHtml = `<p style="margin-top:8px; font-size:0.85rem; color:#58a6ff;">📊 CPU: ${m.cpu}% | RAM: ${m.ram}MB</p>`;
							}
						} catch(e) {}
					}

					let assignHtml = '';
					if (currentUserRole === 'admin') {
						assignHtml = `<hr style="border-color:var(--border-color); margin: 8px 0;"/>
							<div style="display:flex; gap:4px;">
								<input type="text" id="assign_${c.name}" placeholder="Assign to email..." style="width:100%; padding:4px; background:#000; color:#fff; border:1px solid #30363d; border-radius:4px;" />
								<button onclick="window.assignContainer('${c.name}')" class="btn btn-sm btn-outline">Assign</button>
							</div>`;
					}

					card.innerHTML = `
						<div class="card-header">
							<h3>${c.name}</h3>
							<span class="status-badge ${statusClass}">${c.state}</span>
						</div>
						<div class="card-body">
							<p>Architecture: ${c.architecture}</p>
							${metricsHtml}
						</div>
						<div class="card-actions">
							${c.state === 'Stopped' ? `<button onclick="window.containerAction('${c.name}', 'start')" class="btn btn-sm btn-success">Start</button>` : ''}
							${c.state === 'Running' ? `<button onclick="window.containerAction('${c.name}', 'stop')" class="btn btn-sm btn-warning">Stop</button>
							<button onclick="window.openTerminal('${c.name}')" class="btn btn-sm btn-outline">Terminal</button>` : ''}
							<button onclick="window.containerAction('${c.name}', 'delete')" class="btn btn-sm btn-danger">Delete</button>
						</div>
						${assignHtml}
					`;
					grid.appendChild(card);
				}
			} catch (err) {
				console.error(err);
				window.location.href = "/"; // Redirect to login if unauth
			}
		}

		// User Management
		async function fetchUsers() {
			const res = await fetch(`${API_URL}/users`, {credentials: 'include'});
			if(!res.ok) return;
			const users = await res.json();
			const grid = document.getElementById('usersGrid');
			grid.innerHTML = '';
			users.forEach(u => {
				const card = document.createElement('div');
				card.className = 'container-card';
				card.innerHTML = `
					<div class="card-header"><h3>${u.email}</h3><span class="status-badge status-running">${u.role}</span></div>
					<div class="card-body">
						<p style="display:flex; justify-content:space-between; margin-bottom:4px;">RAM Quota (MB): <input type="number" id="qram_${u.id}" value="${u.quota_ram}" style="width:70px; background:#000; color:#fff; border:1px solid #30363d;"/></p>
						<p style="display:flex; justify-content:space-between;">CPU Quota: <input type="number" id="qcpu_${u.id}" value="${u.quota_cpu}" style="width:70px; background:#000; color:#fff; border:1px solid #30363d;"/></p>
					</div>
					<div class="card-actions">
						<button onclick="window.updateQuota(${u.id})" class="btn btn-sm btn-primary">Save Quotas</button>
					</div>
				`;
				grid.appendChild(card);
			});
		}

		window.updateQuota = async function(id) {
			const qram = document.getElementById(`qram_${id}`).value;
			const qcpu = document.getElementById(`qcpu_${id}`).value;
			const res = await fetch(`${API_URL}/users/${id}`, {
				method: 'PUT',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ quota_ram: qram, quota_cpu: qcpu }),
				credentials: 'include'
			});
			if(res.ok) alert("Quotas updated!");
			else alert("Failed to update quotas.");
		};

		window.assignContainer = async function(name) {
			const email = document.getElementById(`assign_${name}`).value;
			const res = await fetch(`${API_URL}/containers/${name}/assign`, {
				method: 'PUT',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email: email }),
				credentials: 'include'
			});
			if(res.ok) {
				alert(email ? `Assigned to ${email}` : "Unassigned container");
				fetchContainers();
			} else alert("Failed to assign (user must exist)");
		};

		// Actions
		window.containerAction = async function(name, action) {
			if(action === 'delete' && !confirm(`Are you sure you want to delete ${name}?`)) return;
			
			try {
				const res = await fetch(`${API_URL}/containers/${name}/${action}`, {
					method: 'POST',
					credentials: 'include'
				});
				if (res.ok) fetchContainers();
				else alert("Action failed.");
			} catch (err) {
				console.error(err);
			}
		};

		// Create
		document.getElementById('createForm').addEventListener('submit', async (e) => {
			e.preventDefault();
			const btn = document.getElementById('createBtn');
			btn.disabled = true;
			btn.textContent = "Creating...";

			const data = {
				name: document.getElementById('cName').value,
				ram_mb: parseInt(document.getElementById('cRam').value),
				cpu_cores: parseInt(document.getElementById('cCpu').value)
			};

			try {
				const res = await fetch(`${API_URL}/containers`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
					credentials: 'include'
				});
				
				if(res.ok) {
					document.getElementById('createForm').reset();
					document.getElementById('ramVal').textContent = '512';
					document.getElementById('cpuVal').textContent = '1';
					fetchContainers();
				} else {
					const err = await res.json();
					alert(err.description || err.error || "Failed to create container.");
				}
			} finally {
				btn.disabled = false;
				btn.textContent = "Launch Container";
			}
		});

		// Invite Logic
		const inviteForm = document.getElementById('inviteForm');
		if(inviteForm) {
			inviteForm.addEventListener('submit', async (e) => {
				e.preventDefault();
				const btn = e.target.querySelector('button');
				btn.disabled = true;
				try {
					const res = await fetch(`${API_URL}/users`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ email: document.getElementById('uEmail').value }),
						credentials: 'include'
					});
					if(res.ok) {
						alert("User invited successfully!");
						e.target.reset();
					} else {
						const err = await res.json();
						alert(err.error || "Failed to invite");
					}
				} finally {
					btn.disabled = false;
				}
			});
		}

		const refreshUsersBtn = document.getElementById('refreshUsersBtn');
		if (refreshUsersBtn) refreshUsersBtn.addEventListener('click', fetchUsers);
		
		document.getElementById('refreshBtn').addEventListener('click', fetchContainers);
		document.getElementById('logoutBtn').addEventListener('click', () => {
			document.cookie = "session_token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
			window.location.href = "/";
		});

		// Terminal Logic
		let currentTermContainer = "";
		window.openTerminal = function(name) {
			currentTermContainer = name;
			document.getElementById('termTitle').textContent = `Terminal: ${name}`;
			document.getElementById('termOutput').innerHTML = `<p style="color:#58a6ff;">Connected to ${name}. Ready for commands.</p>`;
			document.getElementById('terminalModal').style.display = 'block';
			document.getElementById('termInput').focus();
		};

		document.getElementById('termForm').addEventListener('submit', async (e) => {
			e.preventDefault();
			const inputField = document.getElementById('termInput');
			const cmd = inputField.value;
			if(!cmd) return;
			inputField.value = "";
			
			const out = document.getElementById('termOutput');
			out.innerHTML += `<p style="color:#c9d1d9;">$ ${cmd}</p>`;
			out.scrollTop = out.scrollHeight;

			try {
				const res = await fetch(`${API_URL}/containers/${currentTermContainer}/terminal`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ command: cmd }),
					credentials: 'include'
				});
				const data = await res.json();
				if(data.stdout) out.innerHTML += `<pre style="color:#c9d1d9;">${data.stdout}</pre>`;
				if(data.stderr) out.innerHTML += `<pre style="color:#f85149;">${data.stderr}</pre>`;
				if(data.error) out.innerHTML += `<p style="color:#f85149;">Error: ${data.error}</p>`;
			} catch(err) {
				out.innerHTML += `<p style="color:#f85149;">Failed to execute.</p>`;
			}
			out.scrollTop = out.scrollHeight;
		});

		// Init
		(async function init() {
			await fetchUser();
			await fetchContainers();
		})();
	</script>
</body>
</html>
